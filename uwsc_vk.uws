// uwsc_vk.uws MPC-BEにイベント送信、簡易メッセージなども
if PARAM_STR[0]="msg"
  r = msgbox(PARAM_STR[1],BTN_OK or BTN_CANCEL)
  exitexit r
endif
W_MPC=getid("MPC-BE x64","MPC-BE",5)
if W_MPC=-1 then fukidasi("WindowID取得失敗,MPC-BEを起動してください")
ctrlwin(W_MPC, ACTIVATE)
if PARAM_STR[0]="fullsc" then sckey(W_MPC,VK_ALT,VK_RETURN)
mouseorg(W_MPC,MORG_DIRECT)
if PARAM_STR[0]="next"   then kbd(VK_NEXT)
if PARAM_STR[0]="prior"  then kbd(VK_PRIOR)
if PARAM_STR[0]="up"     then kbd(VK_UP)
if PARAM_STR[0]="down"   then kbd(VK_DOWN)
if PARAM_STR[0]="track"  then kbd(VK_A)
if PARAM_STR[0]="play"   then kbd(VK_PLAY)
if PARAM_STR[0]="stop"   then kbd(VK_MEDIA_STOP)
if PARAM_STR[0]="home"   then kbd(VK_HOME)
if PARAM_STR[0]="playst" then kbd(VK_SPACE)
if PARAM_STR[0]="nextsb" then kbd(VK_S)
if PARAM_STR[0]="f1"
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
  kbd(VK_F1);sleep(0.1)
endif
if PARAM_STR[0]="f2"
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
  kbd(VK_F2);sleep(0.1)
endif
